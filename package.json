{
  "name": "studentapi",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "tsc": "tsc",
    "db:generate": "npx drizzle-kit generate --config=./drizzle.config.ts",
    "db:push": "npx drizzle-kit push --config=./drizzle.config.ts",
    "db:push:test": "NODE_ENV=development npx drizzle-kit push --config=./drizzle-test.config.ts",
    "db:studio": "npx drizzle-kit studio --config=./drizzle.config.ts",
    "db:migrate": "npx tsx ./src/db/migrate.ts",
    "dev": "NODE_ENV=development ts-node-dev src/index.ts",
    "start": "NODE_ENV=production node build/src",
    "format": "pnpm biome format --write ./src",
    "test": "NODE_ENV=test glob glob 'src/**/*.test.ts' -c 'tsx --test'",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "express": "^4.21.2",
    "morgan": "^1.10.0",
    "postgres": "^3.4.5",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.30.2",
    "glob": "^11.0.1",
    "husky": "^9.1.7",
    "supertest": "^7.0.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
